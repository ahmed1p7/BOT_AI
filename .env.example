# ═══════════════════════════════════════════════════════════════
# 🤖 Fᴀᴛɪᴍᴀ WhatsApp Bot - ملف الإعدادات
# ═══════════════════════════════════════════════════════════════

# معلومات البوت الأساسية
BOT_NAME=Fᴀᴛɪᴍᴀ
BOT_PREFIX=.
BOT_VERSION=1.0.0
BOT_LANGUAGE=ar

# رقم المالك الرئيسي (بدون + أو مسافات)
OWNER_NUMBER=1234567890

# مالكين إضافيين (مفصولين بفاصلة)
ADDITIONAL_OWNERS=

# ═══════════════════════════════════════════════════════════════
# 🔧 إعدادات قاعدة البيانات
# ═══════════════════════════════════════════════════════════════
MONGODB_URI=mongodb://localhost:27017/fatima-bot

# ═══════════════════════════════════════════════════════════════
# 🤖 إعدادات الذكاء الاصطناعي
# ═══════════════════════════════════════════════════════════════
AI_ENABLED=true
AI_MODEL=gpt-4
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.7

# ═══════════════════════════════════════════════════════════════
# ⚙️ إعدادات عامة
# ═══════════════════════════════════════════════════════════════
# الحد الأقصى للرسائل في الدقيقة للمستخدم الواحد
RATE_LIMIT=10

# تفعيل وضع القراءة (علامات القراءة الزرقاء)
READ_MESSAGES=true

# تفعيل الكتابة أثناء الرد
TYPING_INDICATOR=true

# حفظ الجلسات تلقائياً
AUTO_SAVE_SESSION=true

# ═══════════════════════════════════════════════════════════════
# 📢 إعدادات الترحيب والمغادرة
# ═══════════════════════════════════════════════════════════════
WELCOME_ENABLED=true
WELCOME_MESSAGE=مرحباً بك @user في مجموعة @group! 🎉

GOODBYE_ENABLED=true
GOODBYE_MESSAGE=وداعاً @user، نتمنى لك التوفيق! 👋

# ═══════════════════════════════════════════════════════════════
# 🔒 إعدادات الأمان
# ═══════════════════════════════════════════════════════════════
ANTI_LINK=false
ANTI_SPAM=true
ANTI_DELETE=false

# ═══════════════════════════════════════════════════════════════
# 📁 مسارات الملفات
# ═══════════════════════════════════════════════════════════════
SESSION_PATH=./data/sessions
MEDIA_PATH=./data/media
LOG_PATH=./logs
